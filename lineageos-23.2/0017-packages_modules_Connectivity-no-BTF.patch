From a5fdcc355a8f73426781bee9e8d4c3aaaceb36c1 Mon Sep 17 00:00:00 2001
From: Yaroslav Zviezda <acroreiser@gmail.com>
Date: Sat, 16 May 2026 15:12:13 -0400
Subject: [PATCH] Do not require BTF on pre-5.15

We are not ready yet.

Change-Id: Idba6d2673854f4aea47d6498464905aba03385fc
---
 bpf/loader/NetBpfLoad.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/modules/Connectivity/bpf/loader/NetBpfLoad.cpp b/packages/modules/Connectivity/bpf/loader/NetBpfLoad.cpp
index d4d3aa3..79840e6 100644
--- a/packages/modules/Connectivity/bpf/loader/NetBpfLoad.cpp
+++ b/packages/modules/Connectivity/bpf/loader/NetBpfLoad.cpp
@@ -824,7 +824,7 @@ static int createMaps(ElfObject& elfObj, vector<struct bpf_map_def>& md, vector<
     vector<char> btfData;
     struct btf *btf = NULL;
     auto btfGuard = base::make_scope_guard([&btf] { if (btf) btf__free(btf); });
-    if (isAtLeastKernelVersion(4, 19)) {
+    if (isAtLeastKernelVersion(5, 15)) {
         // On Linux Kernels older than 4.18 BPF_BTF_LOAD command doesn't exist.
         ret = elfObj.readSectionByName(".BTF", btfData);
         if (ret) {
@@ -1308,7 +1308,7 @@ static int loadProgByLibbpf(const char* const elfPath) {
     ret = bpf_object__load(obj);
     if (ret) return ret;
     // On Linux Kernels older than 4.18 BPF_BTF_LOAD command doesn't exist.
-    if (isAtLeastKernelVersion(4, 19) && bpf_object__btf_fd(obj) < 0) return -1;
+    if (isAtLeastKernelVersion(5, 15) && bpf_object__btf_fd(obj) < 0) return -1;
 
     ret = pinMaps(obj, md);
     if (ret) return ret;
-- 
2.53.0

